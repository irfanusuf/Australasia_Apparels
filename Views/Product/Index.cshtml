@model P2WebMVC.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Products";
}




<div class="hero-wrap hero-bread" style="background-image: url('@Url.Content($"~/images/{ViewBag.category}.jpg")');">

    <div class="container">
        <div class="row no-gutters slider-text align-items-center justify-content-center">
            <div class="col-md-9 ftco-animate text-center">
                <p class="breadcrumbs"><span class="mr-2"><a href="index.html">Products > </a></span>
                    <span>@ViewBag.category</span>
                </p>
                <h1 class="mb-0 bread">@ViewBag.category</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section bg-light" style="padding-top: 50px;">
    <div class="container">
        @* <h3 class="pb-3 text-center"> <span style="text-transform: capitalize;">@ViewBag.category </span>  Products </h3> *@

        <div class="row">
            <div class="col-md-8 col-lg-10 order-md-last">

                <div class="row">

                   @if (Model.Products != null && Model.Products.Any())
{
    foreach (var product in Model.Products)
    {
        <div class="col-sm-6 col-md-6 col-lg-4 ftco-animate">
            <div class="product">
                <a asp-controller="Product" asp-action="Details" asp-route-ProductId="@product.ProductId" class="img-prod">
                    <img class="img-fluid" src="@product.ImageUrl" alt="Product Image">
                    <span class="status">@product.Discount.ToString("0") % off</span>
                    <div class="overlay"></div>
                </a>
                <div class="text py-3 px-3">
                    <h3>
                        <a asp-controller="Product" asp-action="Details" asp-route-ProductId="@product.ProductId">@product.Name</a>
                    </h3>
                    <div class="d-flex">
                        <div class="pricing">
                            <p class="price">
                                <span class="mr-2 price-dc">$@product.Price.ToString("0")</span>
                                <span class="price-sale">
                                    $@(Math.Round(product.Price - (product.Price * product.Discount / 100), 2).ToString("0.00"))
                                </span>
                            </p>
                        </div>
                        <div class="rating">
                            <p class="text-right">
                                @{
                                    var rating = (int)(product?.Rating ?? 0);
                                    for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= rating)
                                        {
                                            <a href="#"><span class="ion-ios-star"></span></a>
                                        }
                                        else
                                        {
                                            <a href="#"><span class="ion-ios-star-outline"></span></a>
                                        }
                                    }
                                }
                            </p>
                        </div>
                    </div>

                    <div>
                        @if (!string.IsNullOrEmpty(product?.ReasonForDiscount))
                        {
                            <span class="text-danger">@product.ReasonForDiscount !</span>
                        }
                    </div>

                    <p class="bottom-area d-flex px-3">
                        <a asp-controller="Product" asp-action="AddToCart" asp-route-ProductId="@product.ProductId" class="add-to-cart text-center py-2 mr-1">
                            <span>Add to cart <i class="ion-ios-add ml-1"></i></span>
                        </a>
                    </p>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="col-12 text-center">
        <h4>No products found.</h4>
    </div>
}


                </div>



