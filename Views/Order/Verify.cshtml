@model P2WebMVC.Models.ViewModels.HybridViewModel
@{

    ViewData["Title"] = "Payment";
}


<div class="container mt-4">
    <h4>Payment</h4>

    <div class="mb-3">
        <strong>Order ID:</strong> @Model?.Order?.OrderId
    </div>

     <div class="mb-3">
        <h5>Order Items</h5>
        <ul class="list-group">
            @foreach (var item in Model?.OrderItems)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @item?.Product?.Name
                    <span class="badge bg-primary rounded-pill">
                        @item?.Quantity x @(
                            string.Format("{0:0.00}", item?.Product?.Price - (item?.Product?.Price * (item?.Product?.Discount ?? 0) / 100) ) 
                        )
                    </span>
                </li>
            }
        </ul>
    </div> 

    <div class="mb-3">
        <h5>Order Total</h5>
        <p> <strong> Shipping Cost :</strong>  $ 5.00</p>
        <p><strong>Total Amount:</strong> $ @(Model?.Order.TotalPrice + 5)  ( With Shipping included)</p>


    </div> 


    <div class="mb-3">
        <h5>Shipping Address</h5>
        <address>
            @Model?.Address?.FirstName @Model?.Address?.LastName <br />
            @Model?.Address?.Street,<br /> 
            @Model?.Address?.Phone <br/>
            @Model?.Address?.City, @Model?.Address?.State @Model?.Address?.Pincode<br />
            @Model?.Address?.Country
        </address>
    </div>

    <div class="mb-3">
        <a  asp-controller="Order" asp-action="SendEmail" asp-route-OrderId ="@Model?.Order?.OrderId" class="btn btn-warning">Verify Order through Email</a>


        <span class="ms-5"> @TempData["EmailMessage"]  </span>
    </div>



    <div id="pay-section" class="mb-3" style="display:none;">
        <a class="btn btn-success">Pay</a>
    </div>
</div>

@section Scripts {
    <script>
        function verifyEmail() {
            // Simulate email verification
            document.getElementById('verification-status').innerText = 'Email verified!';
            document.getElementById('verify-email-btn').disabled = true;
            document.getElementById('pay-section').style.display = 'block';
        }
    </script>
}
